<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Library code: AOT/trim-safe, warnings are errors, locals not zero-initialised. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ModuleAttributes.cs" Link="Shared/ModuleAttributes.cs" />
  </ItemGroup>
</Project>
